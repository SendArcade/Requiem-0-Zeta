DATABASE_URL=postgres://postgres:postgres@localhost:5432/beyoracle

# Mercari JP sold comps (live path via api.mercari.jp DPoP search)
MERCARI_API_ENABLED=0
# Throw instead of falling back to fixtures when the live call fails
MERCARI_STRICT=0
# Politeness delay between live requests, in ms
MERCARI_MIN_INTERVAL_MS=1200
MERCARI_MAX_PAGES=5

SHOPEE_API_ENABLED=0

# Worker / cron ingest
# INGEST_INTERVAL_MS=900000
# BACKFILL_PAUSE_CRON_INGEST=0
# INGEST_RUN_STALE_MS=2700000
# BULLMQ_LOCK_DURATION_MS=3600000
# BULLMQ_LOCK_RENEW_MS=30000
# Later product backfill default is burst only in code when unset (do not set a Railway variable here).
# PRODUCT_BACKFILL_GENERATIONS=burst
