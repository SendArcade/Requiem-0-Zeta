{
  "name": "beyoracle",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @beyoracle/db generate",
    "db:migrate": "pnpm --filter @beyoracle/db migrate",
    "db:seed": "pnpm --filter @beyoracle/catalog seed",
    "catalog:build": "pnpm --filter @beyoracle/catalog catalog:build",
    "catalog:sync": "pnpm --filter @beyoracle/catalog catalog:sync",
    "eval:run": "pnpm --filter @beyoracle/oracle eval:run",
    "eval:scoreboard": "pnpm --filter @beyoracle/oracle eval:scoreboard",
    "dev": "pnpm --filter @beyoracle/web dev",
    "worker:dev": "pnpm --filter @beyoracle/worker dev",
    "ingest:fixtures": "pnpm --filter @beyoracle/ingest ingest:fixtures",
    "ingest:run": "pnpm --filter @beyoracle/ingest ingest:run",
    "backfill:oracle": "pnpm --filter @beyoracle/ingest backfill:oracle",
    "purge:bad-comps": "pnpm --filter @beyoracle/ingest purge:bad-comps",
    "purge:bad-comps:dry": "pnpm --filter @beyoracle/ingest purge:bad-comps:dry",
    "backfill:products": "pnpm --filter @beyoracle/ingest backfill:products",
    "backfill:products:shard": "pnpm --filter @beyoracle/ingest backfill:products:shard",
    "backfill:products:fleet-plan": "pnpm --filter @beyoracle/ingest backfill:products:fleet-plan",
    "product:coverage": "pnpm --filter @beyoracle/ingest product:coverage",
    "docker:up": "echo 'DEPRECATED for pricing DB — use Railway (docs/RAILWAY_ONLY.md). Refusing.' && exit 1",
    "docker:down": "echo 'DEPRECATED for pricing DB — use Railway (docs/RAILWAY_ONLY.md).' && exit 1",
    "docker:up:legacy": "docker compose up -d",
    "docker:down:legacy": "docker compose down -v"
  },
  "devDependencies": {
    "@railway/cli": "^5.41.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4"
}
