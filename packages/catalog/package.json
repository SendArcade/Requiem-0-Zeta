{
  "name": "@beyoracle/catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "products:build": "tsx scripts/build-products.ts",
    "products:burst": "node scripts/generate-products-burst.mjs",
    "products:enrich": "tsx scripts/enrich-product-recipes.ts",
    "products:validate": "tsx scripts/validate-product-recipes-cli.ts",
    "products:refresh": "node scripts/generate-products-burst.mjs && tsx scripts/enrich-product-recipes.ts && tsx scripts/validate-product-recipes-cli.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@beyoracle/db": "workspace:*",
    "@beyoracle/shared": "workspace:*",
    "@beyoracle/oracle": "workspace:*",
    "drizzle-orm": "^0.39.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
