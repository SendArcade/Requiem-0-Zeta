  },
  "dependencies": {
    "@beyoracle/shared": "workspace:*",
    "@beyoracle/catalog": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
